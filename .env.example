POSTGRES_DB=coding_agent
POSTGRES_USER=coding_agent
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://coding_agent:replace-with-a-local-password@localhost:5432/coding_agent
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
WORKSPACE_DIR=.
VERBOSE_TOOLS=false
REQUIRE_WRITE_APPROVAL=true
MAX_TOOL_ROUNDS=10
MAX_HISTORY_MESSAGES=40
AGENT_LOG_PATH=logs/agent.jsonl

# Leave blank to run the generic coding agent. Start vk-rag on port 8000 to enable
# the search_vulkan_docs tool for Vulkan validation and API questions.
VULKAN_RAG_URL=http://127.0.0.1:8000
VULKAN_RAG_TIMEOUT_SECONDS=15
